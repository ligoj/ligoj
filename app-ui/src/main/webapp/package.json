{
  "name": "ligoj-ui",
  "version": "0.1.0",
  "description": "Ligoj Vue UI host — main SPA, shared host surface (`@ligoj/host`), plugin loader / registry, dev-server import-map shims.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "kloudy.io",
  "contributors": [
    "Fabrice Daugan <fabrice.daugan@gmail.com>"
  ],
  "homepage": "https://github.com/ligoj/ligoj#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ligoj/ligoj.git",
    "directory": "app-ui/src/main/webapp"
  },
  "bugs": {
    "url": "https://github.com/ligoj/ligoj/issues"
  },
  "keywords": [
    "ligoj",
    "host",
    "spa",
    "vue",
    "vite",
    "vuetify",
    "pinia"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "sass": "^1.105.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
